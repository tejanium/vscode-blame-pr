{
  "publisher": "tejanium",
  "name": "blame-pr",
  "displayName": "Blame Github's Pull Request",
  "description": "Blame and open Github's associated PR.",
  "icon": "img/ico.png",
  "version": "1.1.0",
  "homepage": "https://github.com/tejanium/vscode-blame-pr/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/tejanium/vscode-blame-pr/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejanium/vscode-blame-pr"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blame-pr.open",
        "title": "Blame PR: Open in Github"
      },
      {
        "command": "blame-pr.toggleStatusbar",
        "title": "Blame PR: Toggle Status Bar"
      }
    ],
    "configuration": {
      "title": "Blame Github's PR",
      "properties": {
        "blame-pr.useOAuth": {
          "type": "boolean",
          "default": false,
          "description": "Use GitHub OAuth (via VS Code auth). If false, only public data is used."
        },
        "blame-pr.enablePrefetch": {
          "type": "boolean",
          "default": true,
          "description": "Enable cursor-based prefetching for instant toolbar responses. Prefetches PR data when you dwell on a line for 500ms."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "bun build src/extension.ts --outdir dist --format=cjs --target=node --external vscode --sourcemap",
    "watch": "bun run compile --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "package": "bunx @vscode/vsce package --no-dependencies",
    "clean-build": "rm -rf dist out *.vsix && bun run compile && bun run package",
    "deploy": "bunx @vscode/vsce publish --no-dependencies",
    "deploy:ovsx": "bunx ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.3.1",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^10",
    "nock": "^14.0.10",
    "ovsx": "^1.2.0",
    "prettier": "^3.9.7",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "simple-git": "^3.28.0"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ]
}
