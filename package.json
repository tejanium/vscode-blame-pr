{
	"publisher": "tejanium",
	"name": "blame-pr",
	"displayName": "Blame Github's Pull Request",
	"description": "Blame and open Github's associated PR.",
	"icon": "img/ico.png",
	"version": "1.1.0",
	"homepage": "https://github.com/tejanium/vscode-blame-pr/blob/master/README.md",
	"bugs": {
		"url": "https://github.com/tejanium/vscode-blame-pr/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tejanium/vscode-blame-pr"
	},
	"engines": {
		"vscode": "^1.63.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "blame-pr.open",
				"title": "Blame PR: Open in Github"
			},
			{
				"command": "blame-pr.toggleStatusbar",
				"title": "Blame PR: Toggle Status Bar"
			}
		],
		"configuration": {
			"title": "Blame Github's PR",
			"properties": {
				"blame-pr.useOAuth": {
					"type": "boolean",
					"default": false,
					"description": "Use GitHub OAuth (via VS Code auth). If false, only public data is used."
				},
				"blame-pr.enablePrefetch": {
					"type": "boolean",
					"default": true,
					"description": "Enable cursor-based prefetching for instant toolbar responses. Prefetches PR data when you dwell on a line for 500ms."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun build src/extension.ts --outdir dist --format=cjs --target=node --external vscode --sourcemap",
		"compile": "bun build src/extension.ts --outdir dist --format=cjs --target=node --external vscode --sourcemap",
		"test-compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "bun build src/extension.ts --outdir dist --format=cjs --target=node --external vscode --sourcemap --watch",
		"pretest": "yarn --frozen-lockfile && yarn compile && yarn test-compile && yarn lint",
		"test": "jest",
		"package": "npx @vscode/vsce package",
		"clean-build": "rm -rf dist out *.vsix && yarn compile && yarn package",
		"deploy": "npx @vscode/vsce publish --yarn"
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.3.1",
		"@types/vscode": "^1.63.0",
		"@typescript-eslint/eslint-plugin": "^8.43.0",
		"@typescript-eslint/parser": "^8.43.0",
		"@vscode/vsce": "^2.15.0",
		"eslint": "^9.35.0",
		"jest": "^30.1.3",
		"jest-mock-vscode": "^4.6.0",
		"nock": "^14.0.10",
		"ts-jest": "^29.4.1",
		"typescript": "5.9.2",
		"typescript-eslint": "^8.43.0"
	},
	"dependencies": {
		"simple-git": "^3.28.0"
	}
}
